# Copy to .env (gitignored) and fill in. Never commit .env.
# Use SINGLE quotes around every value: they keep & ? $ # literal (double quotes or no
# quotes let uv expand $NAME).

# --- Google Cloud / BigQuery ---
# Personal account and project only (not a work account).
GCP_ACCOUNT='you@gmail.com'
GCP_PROJECT_ID='your-unique-project-id'
BQ_LOCATION='asia-south1'
# Absolute path to the service-account JSON key. Keep it OUTSIDE the repo.
BQ_KEYFILE='/Users/you/.config/people-analytics/dbt-sa-key.json'
BQ_DATASET_RAW='raw_hris'
BQ_DATASET_DEV='dbt_dev'
BQ_DATASET_PROD='analytics'

# gcloud/bq use a named configuration scoped to this repo, so the global
# default gcloud account is never touched. Created by scripts/setup_gcp.sh.
# The project has NO billing account (BigQuery sandbox), so it cannot be charged.
CLOUDSDK_ACTIVE_CONFIG_NAME='people-analytics'

# --- Source Postgres on Neon free plan (plays the HRIS + ATS) ---
# DIRECT connection string from the Neon dashboard: the host must NOT contain '-pooler'
# (Fivetran's logical replication needs the direct host; make check-postgres rejects it).
POSTGRES_URL='postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require'

# --- Text-to-SQL eval (Phase 8): the model is called through the Claude Code CLI on a
# subscription. Leave ANTHROPIC_API_KEY unset: the CLI would switch to per-call API billing.
